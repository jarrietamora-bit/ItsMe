<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="16dp">
  <com.google.android.material.textfield.TextInputLayout
      style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
      android:layout_width="match_parent" android:layout_height="wrap_content"
      android:hint="Nombre del Viaje" android:layout_marginBottom="12dp">
    <com.google.android.material.textfield.TextInputEditText android:id="@+id/etTravelName"
        android:layout_width="match_parent" android:layout_height="wrap_content"/>
  </com.google.android.material.textfield.TextInputLayout>
  <com.google.android.material.textfield.TextInputLayout
      style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
      android:layout_width="match_parent" android:layout_height="wrap_content"
      android:hint="Fecha Inicio (dd/mm/aaaa)" android:layout_marginBottom="12dp">
    <com.google.android.material.textfield.TextInputEditText android:id="@+id/etStartDate"
        android:layout_width="match_parent" android:layout_height="wrap_content"/>
  </com.google.android.material.textfield.TextInputLayout>
  <com.google.android.material.textfield.TextInputLayout
      style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
      android:layout_width="match_parent" android:layout_height="wrap_content"
      android:hint="Fecha Fin (dd/mm/aaaa)">
    <com.google.android.material.textfield.TextInputEditText android:id="@+id/etEndDate"
        android:layout_width="match_parent" android:layout_height="wrap_content"/>
  </com.google.android.material.textfield.TextInputLayout>
</LinearLayout>
